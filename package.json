{
  "name": "competition-os",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cos/api dev",
    "db:migrate": "pnpm --filter @cos/db migrate",
    "db:create-platform-admin": "pnpm --filter @cos/db create-platform-admin",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "worker": "pnpm --filter @cos/api worker"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  }
}
