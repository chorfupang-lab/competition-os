# Owner connection: runs migrations and admin scripts. Bypasses row-level security.
DATABASE_URL=postgres://cos_owner:cos_owner_dev@localhost:5432/competition_os
# Application connection: the API's restricted role. Row-level security applies.
APP_DATABASE_URL=postgres://cos_app:cos_app_dev@localhost:5432/competition_os

PORT=3000
NODE_ENV=development
# Comma-separated origins allowed to make cookie-authenticated changes.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Web app URL (checkout return pages).
APP_URL=http://localhost:5173
# Test payment provider (development only; always off in production).
PAYMENTS_TEST_PROVIDER=on
PAYMENTS_TEST_WEBHOOK_SECRET=test-webhook-secret
# Airwallex: set these from your secrets manager. Never commit real values.
# AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
# AIRWALLEX_ENV=demo
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
# AIRWALLEX_WEBHOOK_SECRET=
